# 运行环境是 Linux（见 docs/ARCHITECTURE.md），统一换行符为 LF。
# 不加这一行的后果：Windows 上提交的文件带 CRLF，Linux 上的 shell 脚本和 Makefile 会报错。
* text=auto eol=lf

# 二进制文件不要让 git 做文本转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.parquet binary

# 锁文件在 diff 里噪音太大，但必须入库（保证依赖可复现）
pnpm-lock.yaml linguist-generated=true
go.sum         linguist-generated=true
