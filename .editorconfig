root = true

# 默认：UTF-8、LF、末尾换行、去行尾空格、2 空格缩进
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go 用 tab（gofmt 的约定）
[*.go]
indent_style = tab
indent_size = 4

# Makefile 必须用 tab
[Makefile]
indent_style = tab

# Python（数据开发）用 4 空格
[*.py]
indent_size = 4

# YAML / JSON 用 2 空格
[*.{yaml,yml,json}]
indent_size = 2

# Markdown 里行尾两个空格是换行语法，别去掉
[*.md]
trim_trailing_whitespace = false
