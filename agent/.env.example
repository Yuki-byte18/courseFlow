# courseFlow Agent 服务配置
#
# 复制成 .env 后按需修改。所有项都有默认值，不配也能在本机跑起来。

# ---- HTTP ----
AGENT_HOST=127.0.0.1
AGENT_PORT=8090

# 只接受 Go 后端转发过来的请求。
# Go 会在 X-Internal-Token 里带上这个值，Python 侧校验；
# 这样即使有人直接访问 8090，也拿不到任何东西。
AGENT_INTERNAL_TOKEN=dev-internal-token-change-me

# ---- 推理层 ----
# 只支持 DeepSeek。用户的 API Key 由前端经请求头传进来，服务端不保存。
AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_REQUEST_TIMEOUT_S=120

# ---- Go 业务后端 ----
# 写操作（选课/退课）由 Agent 带用户自己的 token 回调这里，
# 复用 Go 事务里的容量/学分/冲突/防超卖校验，不重复实现。
AGENT_GO_BASE_URL=http://127.0.0.1:8080

# ---- 业务数据库（工具层直接读，不走 Go 后端） ----
# 与 backend/configs/config.yaml 里的 mysql 段保持一致
AGENT_MYSQL_HOST=127.0.0.1
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_USER=root
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_DATABASE=courseflow

# ---- 治理层 ----
# 单次运行的预算上限。超了就中止，不再调用模型和工具。
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_CODE_RUNS=6
# 模型调用总次数。防"一直转圈"的最后一根闸：
# 工具次数用尽后模型仍会一轮轮"再想想"，每次几秒，能拖几分钟。
AGENT_MAX_LLM_CALLS=12
AGENT_MAX_WALL_SECONDS=90
AGENT_TOOL_TIMEOUT_S=15
AGENT_SANDBOX_TIMEOUT_S=10
AGENT_SANDBOX_MAX_OUTPUT_CHARS=8000
# 流式读取的空闲超时（秒）。对端不吐数据时快速失败，
# 而不是干等到总超时才报错。
AGENT_STREAM_IDLE_TIMEOUT_S=45

# 单个子 agent 的工具轮次上限。
# 6 太宽：模型在一个死路上能连撞 6 次，每次都是一次几秒的 LLM 调用。
AGENT_MAX_AGENT_STEPS=4

# 写操作要等人审批。超时自动拒绝。
AGENT_APPROVAL_TIMEOUT_S=240

# 意图识别的置信度阈值：低于它就触发澄清，不硬猜
AGENT_INTENT_THRESHOLD=0.75

# ---- 评测层（可选） ----
# 没有 LangSmith Key 时自动关闭，不影响本地 trace 面板。
AGENT_LANGSMITH_ENABLED=false
AGENT_LANGSMITH_PROJECT=courseflow-agent
LANGSMITH_API_KEY=
