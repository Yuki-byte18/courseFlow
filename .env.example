# ==============================================================================
# courseFlow 环境变量模板
#
# 用法：cp .env.example .env 然后填入真实值
#
# 安全红线：.env 已在 .gitignore 中，绝对不要提交、不要贴进对话或截图。
# 一旦泄露，立刻去服务商后台撤销并重置密钥。
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、基础设施（docker compose 读取）
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=courseflow
MYSQL_USER=courseflow
MYSQL_PASSWORD=change_me_app
MYSQL_PORT=3306

REDIS_PORT=6379

KAFKA_PORT=9092
# 应用与容器同机时用 127.0.0.1；从宿主机连虚拟机内 broker 时改成虚拟机 IP
KAFKA_ADVERTISED_HOST=127.0.0.1

CLICKHOUSE_USER=courseflow
CLICKHOUSE_PASSWORD=change_me_ch
CLICKHOUSE_DB=courseflow
CLICKHOUSE_PORT=8123

# ------------------------------------------------------------------------------
# 二、应用配置覆盖（后端读取，前缀 COURSEFLOW_）
# 优先级：环境变量 > backend/configs/config.yaml > 内置默认值
# 层级用下划线：mysql.max_open_conns -> COURSEFLOW_MYSQL_MAX_OPEN_CONNS
# 切片用逗号：kafka.brokers -> COURSEFLOW_KAFKA_BROKERS=a:9092,b:9092
#
# 注意：上面的 MYSQL_PASSWORD 与下面的 COURSEFLOW_MYSQL_PASSWORD 必须一致
# ------------------------------------------------------------------------------
COURSEFLOW_APP_MODE=debug
COURSEFLOW_LOG_LEVEL=info

COURSEFLOW_MYSQL_HOST=127.0.0.1
COURSEFLOW_MYSQL_PORT=3306
COURSEFLOW_MYSQL_USER=courseflow
COURSEFLOW_MYSQL_PASSWORD=change_me_app
COURSEFLOW_MYSQL_DATABASE=courseflow

COURSEFLOW_REDIS_ADDR=127.0.0.1:6379
COURSEFLOW_REDIS_PASSWORD=

COURSEFLOW_KAFKA_ENABLED=false
COURSEFLOW_KAFKA_BROKERS=127.0.0.1:9092

COURSEFLOW_CLICKHOUSE_ADDR=127.0.0.1:8123
COURSEFLOW_CLICKHOUSE_DATABASE=courseflow
COURSEFLOW_CLICKHOUSE_USER=courseflow
COURSEFLOW_CLICKHOUSE_PASSWORD=change_me_ch

# ------------------------------------------------------------------------------
# 三、业务 Agent（M5 使用，现在留空）
# LLM_ENABLED=false 时 Agent 走规则引擎降级路径，保证演示不翻车
# ------------------------------------------------------------------------------
LLM_ENABLED=false
COURSEFLOW_LLM_API_KEY=
COURSEFLOW_LLM_BASE_URL=https://api.deepseek.com
COURSEFLOW_LLM_MODEL=deepseek-chat
